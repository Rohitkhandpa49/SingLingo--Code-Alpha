# Copy to .env for local development. Replace placeholders before using.

# Local MongoDB container credentials (development only)
MONGO_INITDB_ROOT_USERNAME=signlingo_local
MONGO_INITDB_ROOT_PASSWORD=replace_with_local_only_password
MONGODB_URI=mongodb://signlingo_local:replace_with_local_only_password@localhost:27017/signlingo?authSource=admin
MONGODB_DATABASE=signlingo
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0
MONGODB_CONNECT_TIMEOUT_MS=20000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# Leave unset to use the driver's default unbounded wait-queue timeout.
# MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
# Leave unset to disable idle connection expiry.
# MONGODB_MAX_IDLE_TIME_MS=60000
# History cleanup is manual; unset disables retention cleanup.
# HISTORY_RETENTION_DAYS=365

# Backend configuration
APP_ENV=development
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Password recovery is disabled until SMTP is configured.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_STARTTLS=true
# SMTP_TIMEOUT_SECONDS=10
COOKIE_SECURE=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
GESTURE_CONFIDENCE_THRESHOLD=0.75
# Set only to a curated vocabulary version present in supported_signs.
# ISL_VOCABULARY_VERSION=
# Authenticated gesture WebSocket limits (connection caps/rates are process-local).
WEBSOCKET_MAX_MESSAGE_BYTES=100000
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=20
WEBSOCKET_HEARTBEAT_TIMEOUT_SECONDS=45
WEBSOCKET_RATE_LIMIT_PER_MINUTE=120
WEBSOCKET_MAX_CONNECTIONS_PER_USER=3
WEBSOCKET_SEND_TIMEOUT_SECONDS=5
WEBSOCKET_SEQUENCE_MAX_AGE_SECONDS=60
WEBSOCKET_SESSION_RECHECK_SECONDS=60
WEBSOCKET_SHUTDOWN_TIMEOUT_SECONDS=10
# Configure both paths only for a validated TorchScript model and ordered JSON label list.
# GESTURE_MODEL_PATH=ai-engine/models/checkpoints/gesture-classifier.pt
# GESTURE_LABELS_PATH=ai-engine/models/checkpoints/gesture-labels.json

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Optional local speech recognition; leave unset until the optional package is installed.
# The first request downloads the selected open-source Whisper model.
# WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_DOWNLOAD_ROOT=ai-engine\models\whisper
SPEECH_MAX_AUDIO_BYTES=4000000
SPEECH_MAX_DURATION_SECONDS=60
AI_MODEL_CHECKPOINT=
